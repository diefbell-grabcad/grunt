{
  "compilerOptions": {
	"allowJs": true,
    "target": "ESNext",
	  "module": "ES2022",
    "declaration": false,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "typeRoots": [
      "./node_modules/@types",
      "./src/@types"
    ],
	"noEmit": true
  },
  "include": ["src", "test"]
}
